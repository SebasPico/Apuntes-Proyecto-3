rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isMember(groupId) {
      return signedIn()
          && request.auth.uid in get(groupPath(groupId)).data.integrantesIds;
    }

    function joinRequestPath(groupId, uid) {
      return /databases/$(database)/documents/groups/$(groupId)/join_requests/$(uid);
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'nombreCompleto',
            'email',
            'createdAt'
          ]);
      allow update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nombreCompleto',
            'email'
          ]);
      allow delete: if false;

      match /devices/{tokenId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
            && request.auth.uid == uid
            && request.resource.data.token == tokenId
            && request.resource.data.keys().hasOnly([
              'token',
              'updatedAt',
              'platform'
            ]);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /group_codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['grupoId'])
          && getAfter(groupPath(request.resource.data.grupoId)).data.codigoAcceso == code
          && getAfter(groupPath(request.resource.data.grupoId)).data.creadorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /groups/{groupId} {
      allow create: if signedIn()
          && request.resource.data.creadorId == request.auth.uid
          && request.resource.data.integrantesIds == [request.auth.uid]
          && request.resource.data.keys().hasOnly([
            'nombre',
            'codigoAcceso',
            'integrantesIds',
            'creadorId',
            'createdAt'
          ])
          && getAfter(
            /databases/$(database)/documents/group_codes/$(request.resource.data.codigoAcceso)
          ).data.grupoId == groupId;

      allow get: if isMember(groupId);
      allow list: if signedIn()
          && request.auth.uid in resource.data.integrantesIds;

      allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'integrantesIds'
          ])
          && (
            (
              request.auth.uid in resource.data.integrantesIds
              && !(request.auth.uid in request.resource.data.integrantesIds)
              && resource.data.integrantesIds.hasAll(request.resource.data.integrantesIds)
              && request.resource.data.integrantesIds.size()
                  == resource.data.integrantesIds.size() - 1
            )
            ||
            (
              !(request.auth.uid in resource.data.integrantesIds)
              && request.auth.uid in request.resource.data.integrantesIds
              && request.resource.data.integrantesIds.hasAll(resource.data.integrantesIds)
              && request.resource.data.integrantesIds.size()
                  == resource.data.integrantesIds.size() + 1
              && getAfter(joinRequestPath(groupId, request.auth.uid)).data.codigoAcceso
                  == resource.data.codigoAcceso
            )
          );
      allow delete: if false;

      match /join_requests/{uid} {
        allow create, update: if signedIn()
            && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['codigoAcceso'])
            && request.resource.data.codigoAcceso
                == get(groupPath(groupId)).data.codigoAcceso;
        allow read, delete: if false;
      }

      match /notifications/{notificationId} {
        allow get, list: if isMember(groupId);
        allow create, delete: if false;
        allow update: if isMember(groupId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'leidaPor'
            ])
            && request.auth.uid in request.resource.data.leidaPor
            && request.resource.data.leidaPor.hasAll(resource.data.leidaPor)
            && request.resource.data.leidaPor.size()
                == resource.data.leidaPor.size() + 1;
      }

      match /spaces/{spaceId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
            && request.resource.data.grupoId == groupId
            && request.resource.data.keys().hasOnly([
              'nombre',
              'colorValue',
              'iconKey',
              'grupoId',
              'createdAt'
            ]);
        allow update: if isMember(groupId)
            && request.resource.data.grupoId == groupId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'nombre',
              'colorValue',
              'iconKey'
            ]);
        allow delete: if isMember(groupId);

        match /products/{productId} {
          allow read: if isMember(groupId);
          allow create: if isMember(groupId)
              && request.resource.data.grupoId == groupId
              && request.resource.data.espacioId == spaceId
              && request.resource.data.creadoPor == request.auth.uid
              && request.resource.data.cantidad is int
              && request.resource.data.cantidad >= 0
              && request.resource.data.cantidadMinima is int
              && request.resource.data.cantidadMinima >= 0;
          allow update: if isMember(groupId)
              && request.resource.data.grupoId == groupId
              && request.resource.data.espacioId == spaceId
              && request.resource.data.actualizadoPor == request.auth.uid
              && request.resource.data.cantidad is int
              && request.resource.data.cantidad >= 0
              && request.resource.data.cantidadMinima is int
              && request.resource.data.cantidadMinima >= 0;
          allow delete: if isMember(groupId);
        }
      }
    }
  }
}
